# DMT Frontend Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# App Configuration
NEXT_PUBLIC_APP_NAME=DMT
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_DIAGNOSTICS=true
NEXT_PUBLIC_ENABLE_TRAVEL_MODULE=true
NEXT_PUBLIC_ENABLE_PAYMENT_PROCESSING=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Third-party Services
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G_your_tracking_id

# Internationalization
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,tr,de,fr,ar,ru

# Feature Flags
NEXT_PUBLIC_ENABLE_WHATSAPP_INTEGRATION=true
NEXT_PUBLIC_ENABLE_INSTAGRAM_INTEGRATION=false
NEXT_PUBLIC_ENABLE_VOICE_AI=false

# Data Configuration
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=50
NEXT_PUBLIC_DICOM_VIEWER_ENABLED=true
